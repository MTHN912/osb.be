<mjml>
  <mj-head>
    <mj-title>Welcome to {{dealerName}}</mj-title>
    <mj-preview>Welcome to {{dealerName}} Online Service Booking</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text color="#272F3E" font-size="14px" line-height="22px" padding="0 0 12px 0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F4F6F9">
    <mj-wrapper padding="24px 16px">
      <mj-include path="./header.mjml" />

      <mj-section background-color="#FFFFFF" padding="32px 28px 24px 28px">
        <mj-column>
          <mj-text font-size="18px" font-weight="700" color="#272F3E" padding-bottom="8px">
            Hi {{customerName}},
          </mj-text>
          <mj-text font-size="14px" line-height="22px" color="#4B5563">
            Welcome to <strong>{{dealerName}}</strong>! Your account has been successfully created.
          </mj-text>
          <mj-text font-size="14px" line-height="22px" color="#4B5563">
            You can now easily book service appointments, track your service history, and manage your vehicle details online anytime.
          </mj-text>

          <mj-button background-color="#2A53EE" color="#FFFFFF" font-size="14px" font-weight="600" border-radius="2px" padding="16px 0 24px 0" href="{{bookingUrl}}">
            BOOK A SERVICE
          </mj-button>

          <mj-divider border-color="#E2E8F0" border-width="1px" padding="8px 0 16px 0" />

          <mj-text font-size="12px" line-height="18px" color="#64748B">
            Need help? Contact our support team directly at <a href="tel:{{dealerPhone}}" style="color: #2A53EE; text-decoration: none;">{{dealerPhone}}</a>.
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-include path="./footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
