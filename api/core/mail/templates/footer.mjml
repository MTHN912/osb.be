
<mj-section background-color="#262626" padding="32px 24px 24px 24px">
  <mj-column width="100%">
    <mj-table padding="0">
      <tr>
        <td valign="top" style="width: 40%; padding-right: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
          <div style="font-size: 13px; font-weight: 600; text-transform: uppercase; color: #FFFFFF; letter-spacing: 0.5px; margin-bottom: 8px;">
            Contact Us
          </div>
          <div style="font-size: 12px; line-height: 18px; color: #E6E6E6;">
            <strong style="color: #FFFFFF;">{{dealerName}}</strong><br />
            {{dealerAddress}}<br />
            Hotline: <a href="tel:{{dealerPhone}}" style="color: #4096FF; text-decoration: none;">{{dealerPhone}}</a>
          </div>
        </td>
        <td valign="top" style="width: 32%; padding-right: 12px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
          <div style="font-size: 13px; font-weight: 600; text-transform: uppercase; color: #FFFFFF; letter-spacing: 0.5px; margin-bottom: 8px;">
            Legal Info
          </div>
          <div style="font-size: 12px; line-height: 18px; color: #E6E6E6;">
            <a href="{{frontendUrl}}/terms-of-service" target="_blank" style="color: #E6E6E6; text-decoration: none; display: block; margin-bottom: 4px;">Terms of Service</a>
            <a href="{{frontendUrl}}/privacy-policy" target="_blank" style="color: #E6E6E6; text-decoration: none; display: block;">Privacy Policy</a>
          </div>
        </td>
        <td valign="top" style="width: 28%; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">
          <div style="font-size: 13px; font-weight: 600; text-transform: uppercase; color: #FFFFFF; letter-spacing: 0.5px; margin-bottom: 8px;">
            Visit Us
          </div>
          <div style="font-size: 12px; line-height: 18px; color: #E6E6E6;">
            <a href="https://www.facebook.com" target="_blank" style="color: #4096FF; text-decoration: none; display: inline-block; margin-right: 8px;">Facebook</a>
            <a href="https://www.instagram.com" target="_blank" style="color: #4096FF; text-decoration: none; display: inline-block;">Instagram</a>
          </div>
        </td>
      </tr>
    </mj-table>

    <mj-divider border-color="#3A3A3A" border-width="1px" padding="20px 0 16px 0" />

    <mj-text align="center" color="#8C8C8C" font-size="11px" line-height="16px" padding="0">
      This is an automated notification from the Online Service Booking system.<br />
      © {{currentYear}} {{dealerName}}. All rights reserved.
    </mj-text>
  </mj-column>
</mj-section>
