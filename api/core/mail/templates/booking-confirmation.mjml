<mjml>
  <mj-head>
    <mj-title>Booking Confirmation - {{dealerName}}</mj-title>
    <mj-preview>Your appointment on {{bookingDayDate}} at {{bookingTime}} is confirmed</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" />
      <mj-text color="#272F3E" font-size="14px" line-height="22px" padding="0 0 10px 0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#F4F6F9">
    <mj-wrapper padding="24px 16px">
      <mj-include path="./header.mjml" />

      <mj-section background-color="#FFFFFF" padding="28px 24px 20px 24px">
        <mj-column>
          <mj-text font-size="18px" font-weight="700" color="#272F3E" padding-bottom="4px">
            Booking Confirmation
          </mj-text>
          <mj-text font-size="14px" line-height="20px" color="#64748B" padding-bottom="16px">
            Hi <strong>{{customerName}}</strong>, your service appointment has been received. Booking ID: <strong style="color: #2A53EE;">#{{bookingId}}</strong>
          </mj-text>
          <mj-divider border-color="#E2E8F0" border-width="1px" padding="0 0 20px 0" />

          <!-- Details matching exact Image Reference -->
          <mj-raw>
            {{bookingDetailsHtml}}
          </mj-raw>

          <mj-divider border-color="#E2E8F0" border-width="1px" padding="16px 0 20px 0" />

          <mj-text font-size="13px" line-height="20px" color="#64748B">
            Need to amend or cancel your booking? You can manage your appointment online or contact <strong style="color: #272F3E;">{{dealerName}}</strong> directly at <a href="tel:{{dealerPhone}}" style="color: #2A53EE; text-decoration: none;">{{dealerPhone}}</a>.
          </mj-text>
          <mj-button background-color="#2A53EE" color="#FFFFFF" font-size="14px" font-weight="600" border-radius="2px" padding="12px 0 16px 0" href="{{manageUrl}}">
            VIEW BOOKING DETAILS
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-include path="./footer.mjml" />
    </mj-wrapper>
  </mj-body>
</mjml>
